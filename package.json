{
  "name": "ocg-manager-ui",
  "private": true,
  "version": "1.8.1-arm64.1",
  "packageManager": "pnpm@10.29.2",
  "type": "module",
  "scripts": {
    "prepare": "node scripts/install-git-hooks.mjs",
    "hooks:install": "node scripts/install-git-hooks.mjs",
    "predev": "node scripts/free-dev-port.mjs",
    "dev": "tauri dev",
    "build": "node scripts/release.mjs",
    "build:web": "vue-tsc && vite build",
    "test:routing:live": "pwsh -NoProfile -File scripts/test-routing-live.ps1",
    "release:check": "node scripts/release.mjs --check",
    "test:rust": "cargo test --workspace --locked",
    "test:web": "node --experimental-strip-types --test \"scripts/*.test.mjs\" \"src/**/*.test.ts\"",
    "typecheck": "vue-tsc --noEmit",
    "test": "pnpm run test:web && pnpm run typecheck && pnpm exec vite build && pnpm run test:rust",
    "design:lint": "npx -y @google/design.md@0.3.0 lint DESIGN.md"
  },
  "dependencies": {
    "@novnc/novnc": "^1.7.0",
    "@tauri-apps/cli": "^2.11.4",
    "@vicons/antd": "^0.13.0",
    "naive-ui": "^2.44.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@vitejs/plugin-vue": "^5",
    "typescript": "^5",
    "vite": "^5",
    "vue": "^3",
    "vue-tsc": "^2"
  }
}
