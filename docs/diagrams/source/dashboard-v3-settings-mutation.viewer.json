{
  "schema_version": 1,
  "diagram_type": "workflow",
  "meta": {
    "title": "Dashboard V3 设置变更 / Settings Mutation",
    "quality_profile": "showcase",
    "viewBox": [1080, 650]
  },
  "lanes": [
    { "id": "dashboard", "label": "Dashboard SPA + V3 HTTP" },
    { "id": "core", "label": "CoreState + SQLite + Host" },
    { "id": "exceptions", "label": "Conflict + compensation", "variant": "exception" }
  ],
  "phases": [
    { "id": "prepare", "label": "读取 / Read", "fromCol": 0, "toCol": 1 },
    { "id": "commit", "label": "校验并持久化 / Check + persist", "fromCol": 2, "toCol": 3, "variant": "emphasis" },
    { "id": "effects", "label": "Host effect + result", "fromCol": 4, "toCol": 5 }
  ],
  "mainPath": ["read", "submit", "cas", "persist", "host_effect", "ack"],
  "nodes": [
    { "id": "read", "lane": "dashboard", "col": 0, "type": "frontend", "label": "GET settings", "sublabel": "revision tokens" },
    { "id": "submit", "lane": "dashboard", "col": 1, "type": "frontend", "label": "PUT settings", "sublabel": "expected tokens" },
    { "id": "ack", "lane": "dashboard", "col": 5, "type": "backend", "label": "Result", "sublabel": "success ack" },
    { "id": "cas", "lane": "core", "col": 2, "type": "security", "label": "CAS check", "sublabel": "parse + expect" },
    { "id": "persist", "lane": "core", "col": 3, "type": "database", "label": "Persist", "sublabel": "write + revision" },
    { "id": "host_effect", "lane": "core", "col": 5, "type": "backend", "label": "Host effect", "sublabel": "port change: rebind" },
    { "id": "conflict", "lane": "exceptions", "col": 2, "type": "security", "label": "409 CAS", "sublabel": "revisionConflict" },
    { "id": "refresh", "lane": "exceptions", "col": 4, "type": "messagebus", "label": "Refresh", "sublabel": "review latest" },
    { "id": "compensate", "lane": "exceptions", "col": 5, "type": "security", "label": "Compensate", "sublabel": "500 + port restore" }
  ],
  "edges": [
    { "id": "read-submit", "from": "read", "to": "submit" },
    { "id": "submit-cas", "from": "submit", "to": "cas", "label": "CAS-protected", "variant": "emphasis", "route": "drop", "fromSide": "bottom", "toSide": "top" },
    { "id": "cas-persist", "from": "cas", "to": "persist", "variant": "emphasis" },
    { "id": "persist-effect", "from": "persist", "to": "host_effect" },
    { "id": "effect-ack", "from": "host_effect", "to": "ack", "label": "success / no rebind", "route": "up-channel" },
    { "id": "cas-conflict", "from": "cas", "to": "conflict", "label": "stale", "variant": "security", "role": "error" },
    { "id": "conflict-refresh", "from": "conflict", "to": "refresh", "variant": "dashed", "role": "branch" },
    { "id": "effect-compensate", "from": "host_effect", "to": "compensate", "variant": "security", "role": "error", "fromSide": "bottom", "toSide": "top", "route": "drop" }
  ]
}
