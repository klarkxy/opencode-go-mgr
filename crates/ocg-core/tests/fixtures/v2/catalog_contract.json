{
  "comment": "Black-box Plan catalog contract for OCG Manager v2.0. GET /dashboard/api/providers/catalog is the only Plan source. Internal identity is provider_id. Catalog JSON uses display_name/display_family, creation_availability, verification_policy, verification_runtime_availability, routable, form_fields, risk_notice, model_aliases, pricing_availability, usage_availability, and manual_usage_calibration. risk_notice is omitted when a Plan has none.",
  "catalog_paths": [
    "/dashboard/api/providers/catalog",
    "/dashboard/api/providers"
  ],
  "required_entry_fields": [
    "provider_id",
    "display_name",
    "display_family",
    "creation_availability",
    "verification_policy",
    "verification_runtime_availability",
    "routable",
    "form_fields",
    "model_aliases",
    "pricing_availability",
    "usage_availability",
    "manual_usage_calibration"
  ],
  "risk_notice_fields": ["acknowledgement_id", "version", "content_hash"],
  "custom_create": {
    "custom_config_fields": ["endpoint_url", "upstream_protocol"],
    "model_capability_fields": ["model_id", "protocol"]
  },
  "plans": [
    {
      "provider_id": "opencode",
      "verification_policy": "not_required",
      "verification_runtime_availability": "optional",
      "creation_availability": "available",
      "routable": true,
      "required_aliases": ["deepseek-v4-flash", "minimax-m2.7", "grok-4.5"]
    },
    {
      "provider_id": "opencode-zen-free",
      "verification_policy": "not_required",
      "verification_runtime_availability": "not_applicable",
      "creation_availability": "unavailable",
      "routable": true,
      "singleton": true,
      "required_aliases": ["mimo-v2.5"]
    },
    {
      "provider_id": "command-code",
      "verification_policy": "not_required",
      "verification_runtime_availability": "not_applicable",
      "creation_availability": "available",
      "routable": true
    },
    {
      "provider_id": "custom",
      "verification_policy": "required",
      "verification_runtime_availability": "available",
      "creation_availability": "available",
      "routable": true,
      "model_aliases_empty": true,
      "required_form_field_ids": [
        "endpoint_url",
        "upstream_protocol",
        "model_capabilities"
      ]
    }
  ]
}
